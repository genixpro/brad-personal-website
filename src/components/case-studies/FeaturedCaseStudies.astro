---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'case-studies'>[];
}

const { entries } = Astro.props;
const ordered = [...entries].sort((left, right) => left.data.order - right.data.order);
---

{ordered.length > 0 && (
  <section class="container featured" aria-labelledby="featured-case-studies">
    <h2 id="featured-case-studies">Featured case studies</h2>
    <div class="featured-grid">
      {ordered.map(({ slug, data }) => (
        <article>
          <a href={`/case-studies/${slug}`}>
            <img src={data.image} alt="" />
            <h3>{data.client}</h3>
          </a>
          <p>{data.intro}</p>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .featured {
    padding-block: 2.5rem;
  }

  .featured h2 {
    margin-bottom: 1rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .featured article {
    overflow: hidden;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-muted);
    border-radius: 0.75rem;
  }

  .featured img {
    width: 100%;
    aspect-ratio: 1200 / 740;
    object-fit: contain;
  }

  .featured h3 {
    margin: 0.85rem 1rem 0.25rem;
    color: var(--color-accent-link);
    text-decoration: underline;
  }

  .featured p {
    margin: 0 1rem 1rem;
  }

  @media (max-width: 640px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
